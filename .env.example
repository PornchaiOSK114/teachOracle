# คัดลอกไฟล์นี้เป็น .env.local (สำหรับเครื่องตัวเอง) และตั้งค่าเดียวกันบน Vercel › Settings › Environment Variables

# URL จริงของเว็บ — ใช้กับ canonical / sitemap / OG
# ค่านี้ตั้งเป็นค่าเริ่มต้นใน lib/site.ts อยู่แล้ว ตั้งตัวแปรนี้เฉพาะเมื่อต้องการชี้ไปที่อื่น
NEXT_PUBLIC_SITE_URL=https://teedba.com

# MailerLite — ฟอร์มรับข่าวหน้า /products (secret ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้น NEXT_PUBLIC_)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Cloudflare Web Analytics — สถิติการเข้าชม (ไม่ใช้ cookie จึงไม่ต้องขอความยินยอม)
# หาค่าได้ที่ Cloudflare › Analytics › Web Analytics › Manage site › Install JS Snippet
# ไม่ใส่ค่านี้ = ไม่โหลดสคริปต์ (เหมาะกับตอน dev เพื่อไม่ให้ปนสถิติจริง)
NEXT_PUBLIC_CF_BEACON_TOKEN=cb1a0f25eaff4db68ca5d68e348696dd

# Stripe Payment Link ของ E-Book "Oracle 26ai SQL Tuning" (หน้า /products/oracle-26-ai-sql-tuning)
# ยังไม่ใส่ค่า = ปุ่มสั่งซื้อจะ disable + ขึ้นข้อความ "เปิดสั่งซื้อเร็ว ๆ นี้" โดยอัตโนมัติ
# ใส่ค่าที่ Vercel › Settings › Environment Variables แล้ว redeploy = ปุ่มทำงานทันที (ไม่ต้องแก้โค้ด)
NEXT_PUBLIC_STRIPE_LINK_ORACLE26=

# ลิงก์ฟอร์มสั่งซื้อโปรราคาศิษย์เก่า 490 บาท (ดู docs/ALUMNI_PREORDER.md)
# ได้มาหลัง deploy Apps Script Web App จะเป็น URL ที่ลงท้ายด้วย /exec
# ยังไม่ใส่ค่า = ปุ่มหลัก disable แต่ลิงก์ทักเพจ Facebook ใต้ปุ่มยังใช้ได้ตามปกติ
# กล่องโปรจะหายไปเองหลัง 31 ส.ค. 2569 23:59 โดยไม่ต้องแก้อะไร
NEXT_PUBLIC_ALUMNI_ORDER_URL=

# ============================================================================
# ระบบส่งมอบ E-Book หลังชำระเงิน (ดู docs/DELIVERY_PLAN.md)
# ⚠️ ทุกตัวด้านล่างเป็นค่าลับ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด
#    เพราะค่าที่ขึ้นต้นแบบนั้นจะถูกฝังลงหน้าเว็บที่ใครก็เปิดดูได้
# ============================================================================

# --- ฐานข้อมูล Neon ---
# ตัวนี้ Vercel ใส่ให้เองตอนเชื่อม Neon ผ่าน Vercel › Storage ไม่ต้องกรอกมือ
DATABASE_URL=

# --- ที่เก็บไฟล์ต้นฉบับ Vercel Blob ---
# ตัวนี้ Vercel ใส่ให้เองตอนสร้าง Blob store ไม่ต้องกรอกมือ
# ไฟล์ต้องอัปโหลดแบบ private เท่านั้น ห้าม public
BLOB_READ_WRITE_TOKEN=

# --- Resend (ส่งอีเมลลิงก์รับหนังสือ และรหัส 6 หลัก) ---
# โดเมนที่ยืนยันแล้วคือ mail.teedba.com ที่อยู่ผู้ส่งจึงต้องลงท้ายด้วยโดเมนนี้
RESEND_API_KEY=
RESEND_FROM=

# --- Stripe ---
# แยกสองชุดเพราะ sandbox กับ live เป็นคนละโลก โค้ดดูจาก livemode ของ event แล้วเลือกให้เอง
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

# --- ความปลอดภัยภายใน ---
# APP_SECRET ใช้แฮชรหัส 6 หลักและเซ็นกำกับลิงก์ภายใน สุ่มยาวอย่างน้อย 32 ตัวอักษร
# ถ้าเปลี่ยนค่านี้ รหัสที่ออกไปแล้วทั้งหมดจะใช้ไม่ได้ทันที (ซึ่งเป็นพฤติกรรมที่ถูกต้อง)
APP_SECRET=
# รหัสผ่านหน้า /admin/stamp สำหรับประทับ watermark ด้วยมือ
ADMIN_PASSWORD=
